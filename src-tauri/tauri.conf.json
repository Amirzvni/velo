{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velo",
  "version": "0.1.0",
  "identifier": "com.velo.dm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Velo",
        "width": 1100,
        "height": 700,
        "minWidth": 820,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#0D0D0D"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Fast open-source download manager",
    "longDescription": "Velo downloads files in parallel segments, resumes cleanly, and takes over downloads from your browser.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
